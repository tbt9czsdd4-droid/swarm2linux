[Unit]
Description=Turtle Beach Stealth Pro II service (swarm2linux)
Documentation=https://github.com/tbt9czsdd4-droid/swarm2linux
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.swarm2linux.Stealthd
ExecStart=%h/.local/bin/stealthd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
