import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Headset, Choice, Prefs, About } from "state.slint";
import { Rail, Header, Banner, Overlay, Toast, Page } from "shell.slint";
import { SettingsPage } from "pages/settings.slint";
import { EqualizerPage } from "pages/equalizer.slint";
import { ControlsPage } from "pages/controls.slint";
import { DevicePage } from "pages/device.slint";

export { Headset, Choice, Prefs, About }

// The tray icon and its menu. It has its own copy of the globals; Rust fills both. Tray menus show no check
// marks (Slint 1.18), so the labels say what is on.
export component Tray inherits SystemTrayIcon {
    in property <image> battery-icon;
    // the game EQ presets for the menu: the onboard ones and the saved custom ones
    in property <[Choice]> presets;
    // what the icon and the preset menu last showed, kept by Rust to rebuild them only on a change
    in-out property <string> icon-key;
    in-out property <string> menu-key;
    callback open();
    callback toggle-window();
    callback preset-chosen(int);
    callback quit();

    icon: root.battery-icon;
    title: "swarm2linux";
    tooltip: "Stealth Pro II: " + (!Headset.daemon-running ? "stealthd is not running"
        : !Headset.connected ? "no transmitter"
        : !Headset.headset-link ? "headset off"
        : Headset.battery < 0 ? "battery unknown"
        : "battery " + Headset.battery + "%" + (Headset.charging ? ", charging" : ""))
        + (Headset.daemon-running && Headset.connected && Headset.headset-link && Headset.mic-muted ? ", mic muted" : "");
    clicked => { root.toggle-window(); }

    Menu {
        MenuItem {
            title: "Open swarm2linux";
            activated => { root.open(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Noise cancellation: " + (Headset.anc ? "on" : "off");
            enabled: Headset.available;
            activated => {
                Headset.anc = !Headset.anc;
                Headset.set-bool("anc", Headset.anc);
            }
        }
        MenuItem {
            title: "Superhuman Hearing: " + (Headset.superhuman ? "on" : "off");
            enabled: Headset.available;
            activated => {
                Headset.superhuman = !Headset.superhuman;
                Headset.set-bool("superhuman", Headset.superhuman);
            }
        }
        Menu {
            title: "Game EQ: " + (Headset.game-eq-name != "" ? Headset.game-eq-name : "custom");
            for choice in root.presets: MenuItem {
                title: choice.label;
                enabled: Headset.available;
                activated => { root.preset-chosen(choice.value); }
            }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

export component AppWindow inherits Window {
    in-out property <int> page;
    // kept here so the tab stays while other pages are shown
    in-out property <int> eq-tab;
    in-out property <int> control;

    private property <[Page]> pages: [
        { title: "Settings", icon: @image-url("icons/headphones.svg") },
        { title: "Equalizer", icon: @image-url("icons/equalizer.svg") },
        { title: "Controls", icon: @image-url("icons/controls.svg") },
        { title: "Device", icon: @image-url("icons/device.svg") },
    ];
    private property <string> problem: !Headset.connected
        ? "No transmitter found. Plug in the USB transmitter or the headset's cable."
        : "The headset is off or out of range. Settings show their last known values until it reconnects.";

    // choosing a preset, here or on the headset, ends an edit
    private property <int> game-preset: Headset.game-eq-preset;
    private property <int> mic-preset: Headset.mic-eq-preset;
    changed game-preset => {
        if (self.game-preset != 0) {
            Headset.game-eq-edited = false;
        }
    }
    changed mic-preset => {
        if (self.mic-preset != 0) {
            Headset.mic-eq-edited = false;
        }
    }

    title: "swarm2linux";
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 640px;
    background: Theme.background;
    default-font-size: Theme.label-size;

    HorizontalLayout {
        Rail {
            pages: root.pages;
            current <=> root.page;
        }

        VerticalLayout {
            Header {
                subtitle: root.pages[root.page].title;
            }

            if Headset.daemon-running && !Headset.available: HorizontalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-bottom: 12px;
                Banner { text: root.problem; }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    padding-left: 32px;
                    padding-right: 32px;
                    padding-bottom: 32px;
                    if root.page == 0: SettingsPage { }
                    if root.page == 1: EqualizerPage {
                        tab <=> root.eq-tab;
                    }
                    if root.page == 2: ControlsPage {
                        control <=> root.control;
                    }
                    if root.page == 3: DevicePage { }
                }
            }
        }
    }

    if !Headset.daemon-running: Overlay { }

    Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
    }
}
