// Swarm's "Equalizer" page: the band graph with GAME / MIC tabs, and the preset list.

import { LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Headset, Prefs } from "../state.slint";
import { Card, Label, Hint, Toggle, OptionList, Tabs, OutlineButton } from "../widgets/controls.slint";
import { EqGraph } from "../widgets/eq-graph.slint";

// A saved custom preset, with a delete button that asks first.
component CustomPreset {
    in property <string> name;
    in property <bool> current;
    in property <bool> enabled;
    in-out property <bool> confirming;
    callback selected();
    callback deleted();

    height: 40px;
    accessible-role: list-item;
    accessible-label: root.name;
    accessible-checked: root.current;

    Rectangle {
        border-radius: 4px;
        background: row.has-hover && root.enabled ? Theme.hover : transparent;
    }
    row := TouchArea {
        enabled: root.enabled && !root.confirming;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 12px;
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.current ? Theme.selected : transparent;
            border-width: 1px;
            border-color: root.current ? Theme.selected : Theme.dim;
        }
        Text {
            text: root.confirming ? "Delete " + root.name + "?" : root.name.to-uppercase();
            color: root.confirming ? Theme.text : (root.current ? Theme.selected : (root.enabled ? Theme.text : Theme.dim));
            font-size: Theme.label-size;
            letter-spacing: 0.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.confirming: HorizontalLayout {
            spacing: 6px;
            padding-top: 5px;
            padding-bottom: 5px;
            OutlineButton {
                text: "Delete";
                height: 30px;
                clicked => {
                    root.confirming = false;
                    root.deleted();
                }
            }
            OutlineButton {
                text: "Keep";
                height: 30px;
                clicked => { root.confirming = false; }
            }
        }
        if !root.confirming: Rectangle {
            width: 30px;
            border-radius: 4px;
            background: bin.has-hover ? #3a1d22 : transparent;
            accessible-role: button;
            accessible-label: "Delete " + root.name;
            accessible-action-default => { root.confirming = true; }
            Image {
                width: 16px;
                height: 16px;
                source: @image-url("../icons/trash.svg");
                colorize: bin.has-hover ? Theme.bad : Theme.muted;
            }
            bin := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.confirming = true; }
            }
        }
    }
}

export component EqualizerPage inherits HorizontalLayout {
    in-out property <int> tab;

    private property <string> eq: root.tab == 0 ? "game" : "mic";
    private property <[int]> bands: root.tab == 0 ? Headset.game-eq-bands : Headset.mic-eq-bands;
    private property <[string]> slots: root.tab == 0 ? Headset.game-eq-slots : Headset.mic-eq-slots;
    private property <int> preset: root.tab == 0 ? Headset.game-eq-preset : Headset.mic-eq-preset;
    private property <bool> edited: root.tab == 0 ? Headset.game-eq-edited : Headset.mic-eq-edited;
    private property <bool> slots-full: root.slots[0] != "" && root.slots[1] != "" && root.slots[2] != "" && root.slots[3] != "" && root.slots[4] != "";
    private property <bool> no-custom: root.slots[0] == "" && root.slots[1] == "" && root.slots[2] == "" && root.slots[3] == "" && root.slots[4] == "";
    private property <bool> naming;
    private property <string> new-name;
    private property <string> name-problem: Headset.preset-name-problem(root.eq, root.new-name);

    function select(value: int) {
        if (root.tab == 0) {
            Headset.game-eq-preset = value;
            Headset.set-int("game_eq_preset", value);
        } else {
            Headset.mic-eq-preset = value;
            Headset.set-int("mic_eq_preset", value);
        }
    }

    function set-band(band: int, tenths: int) {
        if (!root.edited) {
            Headset.eq-edit-started(root.eq);
        }
        // the headset switches to unsaved custom bands; show that right away
        if (root.tab == 0) {
            Headset.game-eq-edited = true;
            Headset.game-eq-bands[band] = tenths;
            Headset.game-eq-preset = 0;
        } else {
            Headset.mic-eq-edited = true;
            Headset.mic-eq-bands[band] = tenths;
            Headset.mic-eq-preset = 0;
        }
        Headset.set-band(root.eq, band + 1, tenths);
    }

    function save() {
        if (root.new-name != "" && root.name-problem == "") {
            Headset.save-preset(root.eq, root.new-name);
            root.naming = false;
            root.new-name = "";
        }
    }

    spacing: 24px;

    Card {
        horizontal-stretch: 1;

        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            Tabs {
                titles: ["Game", "Mic"];
                current <=> root.tab;
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: end;
                spacing: 10px;
                Toggle {
                    name: "Show grid";
                    y: (parent.height - self.height) / 2;
                    checked: Prefs.show-grid;
                    toggled(on) => {
                        Prefs.show-grid = on;
                        Prefs.changed();
                    }
                }
                Text {
                    text: "SHOW GRID";
                    color: Theme.muted;
                    font-size: Theme.label-size;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                }
            }
        }

        EqGraph {
            height: 380px;
            bands: root.bands;
            frequencies: root.tab == 0 ? Headset.game-eq-frequencies : Headset.mic-eq-frequencies;
            enabled: Headset.available;
            grid: Prefs.show-grid;
            released(band, tenths) => { root.set-band(band, tenths); }
        }

        if !root.naming: HorizontalLayout {
            spacing: 12px;
            OutlineButton {
                text: "Cancel";
                enabled: Headset.available && root.edited;
                clicked => {
                    Headset.eq-edit-cancelled(root.eq);
                    if (root.tab == 0) {
                        Headset.game-eq-edited = false;
                    } else {
                        Headset.mic-eq-edited = false;
                    }
                }
            }
            Text {
                text: root.preset == 0 ? "Unsaved changes" : "";
                color: Theme.muted;
                font-size: Theme.small-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.slots-full ? "All five custom presets are in use." : "";
                color: Theme.muted;
                font-size: Theme.small-size;
                vertical-alignment: center;
            }
            OutlineButton {
                text: "Save as new preset";
                enabled: Headset.available && !root.slots-full;
                clicked => { root.naming = true; }
            }
        }

        if root.naming: HorizontalLayout {
            spacing: 12px;
            OutlineButton {
                text: "Cancel";
                clicked => {
                    root.naming = false;
                    root.new-name = "";
                }
            }
            Text {
                text: root.name-problem;
                color: Theme.warn;
                font-size: Theme.small-size;
                vertical-alignment: center;
                horizontal-alignment: right;
                horizontal-stretch: 1;
            }
            LineEdit {
                width: 220px;
                placeholder-text: "Preset name";
                text <=> root.new-name;
                accepted => { root.save(); }
                init => { self.focus(); }
            }
            OutlineButton {
                text: "Save";
                primary: true;
                enabled: Headset.available && root.new-name != "" && root.name-problem == "";
                clicked => { root.save(); }
            }
        }
    }

    Card {
        title: "Presets";
        width: 340px;

        VerticalLayout {
            spacing: 8px;
            Text {
                text: "ONBOARD";
                color: Theme.muted;
                font-size: Theme.small-size;
                letter-spacing: 1px;
            }
            OptionList {
                choices: root.tab == 0 ? Headset.game-eq-presets : Headset.mic-eq-presets;
                current: root.preset;
                enabled: Headset.available;
                selected(value) => { root.select(value); }
            }
        }

        VerticalLayout {
            Text {
                text: "CUSTOM";
                color: Theme.muted;
                font-size: Theme.small-size;
                letter-spacing: 1px;
            }
            Rectangle { height: 8px; }
            for name[i] in root.slots: CustomPreset {
                visible: name != "";
                height: name != "" ? 40px : 0;
                name: name;
                current: root.preset == 16 + i;
                enabled: Headset.available;
                selected => { root.select(16 + i); }
                deleted => { Headset.delete-preset(root.eq, name); }
            }
            if root.no-custom: Hint {
                text: "None yet. Shape the curve on the left, then choose Save as new preset.";
            }
        }
    }
}
