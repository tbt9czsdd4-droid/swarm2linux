// Colours and sizes, after Swarm II's dark look.

export global Theme {
    out property <color> background: #111419;
    out property <color> rail: #0e1014;
    out property <color> line: #232831;
    out property <brush> card: @linear-gradient(160deg, #1d222b 0%, #191d25 100%);
    out property <color> field: #252b34;
    out property <color> hover: #262d37;
    out property <color> popup: #20262f;

    out property <color> text: #e9ebee;
    out property <color> muted: #8d949e;
    out property <color> dim: #5b626c;

    out property <color> accent: #7b45f5;
    out property <brush> fill: @linear-gradient(90deg, #6b3ef0 0%, #e2459c 100%);
    out property <color> track: #3a3f48;
    out property <color> selected: #3dd6b8;
    out property <color> good: #35c47f;
    out property <color> warn: #e3a23f;
    out property <color> bad: #e5484d;

    out property <length> title-size: 17px;
    out property <length> label-size: 14px;
    out property <length> small-size: 12px;
    out property <length> radius: 6px;
}
